{
  "name": "architect-os",
  "version": "0.1.0",
  "private": true,
  "description": "Four-tier MCP architecture: proxy, gateway, intent services with sandboxed agent workers, typed data layer.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "workspaces": [
    "packages/contracts",
    "packages/sandbox",
    "data",
    "gateway",
    "services/memory",
    "modules/broker",
    "modules/memory",
    "tools/test-gate",
    "tools/evidence",
    "tools/watch",
    "tools/deliver",
    "tools/define",
    "tools/plan"
  ],
  "scripts": {
    "code": "node scripts/require-run.mjs && node --import tsx packages/sandbox/src/code.ts",
    "review": "node scripts/require-run.mjs && node --import tsx packages/sandbox/src/review.ts",
    "sbx:sign-in": "node scripts/require-run.mjs && node --import tsx packages/sandbox/src/sbx-sign-in.ts",
    "step": "node scripts/require-run.mjs && node --import tsx packages/sandbox/src/step.ts",
    "evidence": "node scripts/require-run.mjs && node --import tsx tools/evidence/src/cli.ts",
    "diagram:isolation": "node scripts/require-run.mjs && node --import tsx features/scripts/isolation-diagram.ts",
    "workflow:gate-push": "node scripts/require-run.mjs && node --import tsx features/scripts/gate-push-entry.ts",
    "watch": "node scripts/require-run.mjs && node --import tsx tools/watch/src/cli.ts",
    "define": "node scripts/require-run.mjs && node --import tsx tools/define/src/cli.ts",
    "plan": "node scripts/require-run.mjs && node --import tsx tools/plan/src/cli.ts",
    "deliver": "node scripts/require-run.mjs && node --import tsx tools/deliver/src/cli.ts",
    "typecheck": "node scripts/require-run.mjs && tsc -b",
    "format": "node scripts/require-run.mjs && prettier --write .",
    "format:check": "node scripts/require-run.mjs && prettier --check .",
    "pretest": "node scripts/require-run.mjs && tsc -b",
    "test": "node scripts/require-run.mjs && cucumber-js",
    "arch": "node scripts/require-run.mjs && depcruise --config .dependency-cruiser.cjs packages data gateway services modules tools",
    "lint": "node scripts/require-run.mjs && npm run format:check --silent && npm run typecheck --silent",
    "check": "node scripts/require-run.mjs && npm test",
    "gate": "node scripts/require-run.mjs && sh tools/test-gate/gate.sh",
    "broker:live": "node scripts/require-run.mjs && cucumber-js --profile live",
    "baseline:pilot": "node scripts/require-run.mjs && node --import tsx baseline/run.ts",
    "baseline:campaign": "node scripts/require-run.mjs && BASELINE_REPEATS=3 node --import tsx baseline/run.ts",
    "baseline:analyze": "node scripts/require-run.mjs && node --import tsx baseline/analyze.ts",
    "baseline:overhead-analyze": "node scripts/require-run.mjs && node --import tsx baseline/overhead-analyze.ts",
    "plan:proposal": "node scripts/require-run.mjs && node --import tsx tools/define/src/proposal-cli.ts",
    "baseline:planning": "node scripts/require-run.mjs && node baseline/planning.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "12.9.0",
    "@cucumber/gherkin": "38.0.0",
    "@cucumber/messages": "32.3.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/cucumber-runner": "10.1.1",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@anthropic-ai/sandbox-runtime": {
      "zod": "4.6.7"
    },
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  }
}

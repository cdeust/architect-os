{
  "name": "architect-os",
  "version": "0.1.0",
  "private": true,
  "description": "Four-tier MCP architecture: proxy, gateway, intent services with sandboxed agent workers, typed data layer.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "workspaces": [
    "packages/contracts",
    "packages/sandbox",
    "data",
    "gateway",
    "services/memory",
    "modules/broker",
    "modules/memory",
    "tools/test-gate"
  ],
  "scripts": {
    "code": "node --import tsx packages/sandbox/src/code.ts",
    "review": "node --import tsx packages/sandbox/src/review.ts",
    "step": "node --import tsx packages/sandbox/src/step.ts",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "tsc -b",
    "test": "cucumber-js",
    "arch": "depcruise --config .dependency-cruiser.cjs packages data gateway services modules tools",
    "lint": "npm run format:check --silent && npm run typecheck --silent",
    "check": "npm test",
    "gate": "sh tools/test-gate/gate.sh",
    "broker:live": "cucumber-js --profile live",
    "baseline:pilot": "node --import tsx baseline/run.ts",
    "baseline:campaign": "BASELINE_REPEATS=3 node --import tsx baseline/run.ts",
    "baseline:analyze": "node --import tsx baseline/analyze.ts",
    "baseline:overhead": "node --import tsx baseline/overhead.ts",
    "baseline:overhead-analyze": "node --import tsx baseline/overhead-analyze.ts"
  },
  "devDependencies": {
    "@cucumber/cucumber": "12.9.0",
    "@cucumber/gherkin": "38.0.0",
    "@cucumber/messages": "32.3.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/cucumber-runner": "10.1.1",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@anthropic-ai/sandbox-runtime": {
      "zod": "4.6.7"
    },
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  }
}

{
  "description": "La commande de livraison : les branches à publier dans l'ordre, la branche d'essai, le workflow et ses jobs exigés, les fichiers en ajout seul, le verdict de la porte et les bornes d'attente (docs/design/orchestration-fable-5-2.md §14, « Étape 1, la commande de livraison »). La clé `environment` est la liste fermée des noms des variables de l'hôte que la commande donne à git et au client de la forge, avec ce que chacun pose lui-même : aucune autre ne passe (§14, « Un environnement fermé pour git »).",
  "remote": "origin",
  "repository": "cdeust/architect-os",
  "branches": ["feat/gate-1a", "main"],
  "trialPrefix": "sentinel/gate-1a-",
  "workflow": "gate",
  "requiredJobs": ["gate-linux", "gate-macos"],
  "jobDependencies": {
    "gate-linux": {
      "producers": [
        "gate-linux-cucumber-1",
        "gate-linux-cucumber-2",
        "gate-linux-lane-1 / mutation",
        "gate-linux-lane-1 / replay",
        "gate-linux-lane-2 / mutation",
        "gate-linux-lane-2 / replay",
        "gate-linux-lane-3 / mutation",
        "gate-linux-lane-3 / replay",
        "gate-linux-lane-4 / mutation",
        "gate-linux-lane-4 / replay",
        "gate-linux-lane-5 / mutation",
        "gate-linux-lane-5 / replay",
        "gate-linux-lane-6 / mutation",
        "gate-linux-lane-6 / replay",
        "gate-linux-lane-7 / mutation",
        "gate-linux-lane-7 / replay",
        "gate-linux-lane-8 / mutation",
        "gate-linux-lane-8 / replay",
        "gate-linux-lane-9 / mutation",
        "gate-linux-lane-9 / replay",
        "gate-linux-lane-10 / mutation",
        "gate-linux-lane-10 / replay",
        "gate-linux-lane-11 / mutation",
        "gate-linux-lane-11 / replay",
        "gate-linux-lane-12 / mutation",
        "gate-linux-lane-12 / replay",
        "gate-linux-lane-13 / mutation",
        "gate-linux-lane-13 / replay",
        "gate-linux-lane-14 / mutation",
        "gate-linux-lane-14 / replay",
        "gate-linux-lane-15 / mutation",
        "gate-linux-lane-15 / replay",
        "gate-linux-lane-16 / mutation",
        "gate-linux-lane-16 / replay"
      ],
      "admissionStep": "Require all producers"
    }
  },
  "appendOnly": ["docs/design/journal.md"],
  "gateVerdict": "reports/gate-base.json",
  "gateCommand": ["npm", "run", "gate"],
  "gateLog": "reports/deliver-gate.log",
  "log": "${home}/.local/state/architect-os/deliveries.jsonl",
  "environment": [
    "PATH",
    "HOME",
    "LANG",
    "LC_ALL",
    "LC_CTYPE",
    "TMPDIR",
    "SSH_AUTH_SOCK",
    "XDG_CONFIG_HOME",
    "GH_TOKEN",
    "GITHUB_TOKEN"
  ],
  "ciAttempts": 6,
  "pollSeconds": 30,
  "ciPolls": 90,
  "ruleSuitePolls": 10
}

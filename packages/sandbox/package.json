{
  "name": "@architect-os/sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Port SandboxRunner et adaptateur srt ; outil de code isolé de la brique 1a.0.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./require-run": "./require-run.mjs",
    "./runtime-context": {
      "types": "./dist/src/runtime-context.d.ts",
      "default": "./src/runtime-context.ts"
    },
    "./state-journal": {
      "types": "./dist/src/state-journal.d.ts",

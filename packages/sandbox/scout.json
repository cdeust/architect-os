{
  "description": "Session d'éclairage (docs/design/orchestration-fable-5-2.md, §13) : même commande, même profil en lecture seule et même proxy d'authentification que la revue, prompt système pris dans le checkout du lanceur. Elle répond à une question sur le dépôt par des faits (fichier, ligne, citation) que l'hôte vérifie en lisant le fichier. Aucun secret dans la sandbox.",
  "profile": "reviewer",
  "command": ["claude", "--bare", "--settings", "${config}/settings.json", "--strict-mcp-config"],
  "launcherPromptFile": "prompts/scout.md",
  "authProxy": {
    "upstream": "https://api.anthropic.com",
    "routes": ["^/v1/messages(/count_tokens)?(\\?[^#]*)?$"],
    "betas": ["oauth-2025-04-20"],
    "policy": {
      "bodyFields": [
        "context_management",
        "max_tokens",
        "messages",
        "metadata",
        "model",
        "output_config",
        "stop_sequences",
        "stream",
        "system",
        "temperature",
        "thinking",
        "tool_choice",
        "tools"
      ],
      "maxBodyBytes": 67108864
    },
    "credentialCommand": [
      "/usr/bin/security",
      "find-generic-password",
      "-s",
      "Claude Code-credentials",
      "-w"
    ],
    "usageLog": "${state}/usage.jsonl"
  }
}

{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "findings", "not_checked"],
  "properties": {
    "verdict": { "enum": ["accept", "request_changes"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "file", "line", "quote", "reason"],
        "properties": {
          "level": { "enum": ["correctness", "contradiction", "proposal"] },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "quote": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "not_checked": { "type": "array", "items": { "type": "string" } }
  }
}

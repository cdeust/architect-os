{
  "build": {
    "model": "claude-sonnet-5-5",
    "effort": "medium",
    "limitSeconds": 4800
  },
  "checks": [
    {
      "name": "format",
      "command": [
        "npx",
        "prettier",
        "--check",
        "."
      ],
      "limitSeconds": 300
    },
    {
      "name": "types",
      "command": [
        "npx",
        "tsc",
        "-p",
        "features/tsconfig.json",
        "--noEmit",
        "--composite",
        "false",
        "--incremental",
        "false"
      ],
      "limitSeconds": 600
    },
    {
      "name": "docs",
      "command": [
        "npx",
        "cucumber-js",
        "--profile",
        "replay",
        "features/descriptive"
      ],
      "limitSeconds": 600
    }
  ],
  "reviews": [
    {
      "name": "correctness",
      "model": "claude-opus-5-5",
      "effort": "high",
      "limitSeconds": 1500
    }
  ],
  "parallel": 2
}

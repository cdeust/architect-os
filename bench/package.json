{
  "name": "@architect-os/bench-sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Banc de preuve brique 1b.0 : srt sur Linux et macOS (0.0.81 a la brique 1b.0, 0.0.83 depuis 1b.8), faux amont local, aucune cle reelle.",
  "engines": {
    "node": ">=26.11.1"
  },
  "scripts": {
    "bench:sandbox": "node ../scripts/require-run.mjs && node --import tsx src/run.ts",
    "typecheck": "node ../scripts/require-run.mjs && tsc --noEmit -p tsconfig.json",
    "bench:bare": "node ../scripts/require-run.mjs && node src/bare-launch.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.326",
    "@anthropic-ai/sandbox-runtime": "0.0.83",
    "@modelcontextprotocol/sdk": "1.32.2",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  }
}

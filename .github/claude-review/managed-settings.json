{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "allowManagedHooksOnly": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(mcp__github_comment__update_claude_comment|mcp__github_inline_comment__create_inline_comment)$",
        "hooks": [{ "type": "command", "command": "python3 -I /etc/claude-code/comment-guard.py" }]
      }
    ]
  },
  "permissions": {
    "deny": ["Bash", "WebFetch", "WebSearch", "Write", "Edit", "NotebookEdit", "Read(.git/**)"],
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "blockReadsOutsideWorkingDirectories": true
  }
}

      "memory-recall": {
        "command": "node",
        "args": ["modules/memory-recall/dist/src/serve.js"]
      },
      "judge": {
        "command": "node",
        "args": ["modules/judge/dist/src/serve.js"]
      },
      "memory-write": {
        "command": "node",
        "args": ["modules/memory-write/dist/src/serve.js"]
      },
      "verify": {
        "command": "node",
        "args": ["modules/verify/dist/src/serve.js"]
      },
      "scout": {
        "command": "node",
        "args": ["modules/scout/dist/src/serve.js"]
      }
